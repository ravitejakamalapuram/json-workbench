{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@json-workbench/core": ["./packages/core/src/index.ts"],
      "@json-workbench/core/input": ["./packages/core/src/input.ts"]
    }
  },
  "include": ["packages", "apps"],
  "exclude": ["apps/extension/src/legacy"]
}
