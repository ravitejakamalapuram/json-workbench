# Chrome Web Store Publishing API Credentials
# Official Scope: https://www.googleapis.com/auth/chromewebstore
CWS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
CWS_CLIENT_SECRET=your-oauth-client-secret
CWS_REFRESH_TOKEN=1//your-oauth-refresh-token
CWS_PUBLISHER_ID=your-publisher-id
CWS_EXTENSION_ID=your-cws-extension-id
