{
  "name": "json-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Chrome workbench for massive JSON manipulation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace @json-workbench/extension",
    "package:check": "node scripts/package-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench packages/core/src/large-data.bench.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@monaco-editor/react": "^4.7.0",
    "jq-web": "^0.6.2",
    "jsonata": "^2.1.0",
    "lossless-json": "^4.3.1",
    "monaco-editor": "^0.53.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
